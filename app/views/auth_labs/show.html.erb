<% content_for :title, t("common.auth_lab") %>

<div class="rounded-3xl border border-emerald-200 bg-emerald-50 p-8 shadow-sm">
  <p class="text-sm uppercase tracking-[0.2em] text-emerald-700"><%= t("auth_lab.protected") %></p>
  <h1 class="mt-3 text-3xl font-semibold tracking-tight text-emerald-950"><%= t("auth_lab.heading") %></h1>
  <p class="mt-3 max-w-2xl text-sm leading-7 text-emerald-900/90"><%= t("auth_lab.description") %></p>

  <dl class="mt-8 grid gap-4 md:grid-cols-2">
    <div class="rounded-2xl border border-emerald-200 bg-white p-5">
      <dt class="text-sm text-emerald-700"><%= t("auth_lab.current_user") %></dt>
      <dd class="mt-2 text-lg font-semibold text-slate-900"><%= @current_user.email_address %></dd>
    </div>
    <div class="rounded-2xl border border-emerald-200 bg-white p-5">
      <dt class="text-sm text-emerald-700"><%= t("auth_lab.current_session") %></dt>
      <dd class="mt-2 break-all text-sm font-mono text-slate-900"><%= Current.session.id %></dd>
    </div>
  </dl>
</div>
