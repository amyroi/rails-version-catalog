<% if feature.adoption_readiness_available? %>
  <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500"><%= t("ui.adoption") %></p>
        <h2 class="mt-1 text-xl font-semibold text-slate-900"><%= t("ui.consider") %></h2>
      </div>
      <p class="max-w-2xl text-sm leading-6 text-slate-600">
        <%= t("ui.adoption_help") %>
      </p>
    </div>

    <div class="grid gap-4 [grid-template-columns:repeat(auto-fit,minmax(min(100%,14rem),1fr))]">
      <% [
        [ t("ui.when"), feature.adoption_when ],
        [ t("ui.cautions"), feature.adoption_cautions ],
        [ t("ui.alternatives"), feature.adoption_alternatives ],
        [ t("ui.requirements"), feature.adoption_requirements ]
      ].each do |heading, items| %>
        <% next if items.blank? %>

        <article class="rounded-2xl border border-slate-200 bg-slate-50 p-5 shadow-sm">
          <h3 class="text-base font-semibold text-slate-900"><%= heading %></h3>
          <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-slate-700">
            <% items.each do |item| %>
              <li><%= item %></li>
            <% end %>
          </ul>
        </article>
      <% end %>
    </div>
  </section>
<% end %>
