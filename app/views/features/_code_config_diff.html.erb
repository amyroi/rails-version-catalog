<section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">Code / config diff</p>
      <h2 class="mt-1 text-xl font-semibold text-slate-900">What changes in files and examples</h2>
    </div>
    <p class="max-w-2xl text-sm leading-6 text-slate-600">
      This section groups the version-specific files, snippets, and operational notes so the comparison stays separate from the live demo below.
    </p>
  </div>

  <div class="grid gap-4 [grid-template-columns:repeat(auto-fit,minmax(16rem,1fr))]">
    <% comparison_versions.each do |version| %>
      <article class="rounded-2xl border border-slate-200 bg-slate-50 p-5 shadow-sm">
        <div class="flex items-start justify-between gap-3">
          <div>
            <h3 class="text-lg font-semibold text-slate-900"><%= version.label %></h3>
            <% if (status = feature.status_for(version.key)).present? %>
              <p class="mt-1 text-sm text-slate-600">Status: <%= status %></p>
            <% end %>
          </div>
          <% if feature.highlight_for(version.key).present? %>
            <span class="rounded-full bg-white px-2.5 py-1 text-xs font-semibold text-slate-600">Focused</span>
          <% end %>
        </div>

        <div class="mt-4 space-y-4 text-sm text-slate-700">
          <div>
            <p class="font-semibold text-slate-900">Files / config involved</p>
            <% if feature.files_for(version.key).any? %>
              <ul class="mt-2 space-y-1">
                <% feature.files_for(version.key).each do |file| %>
                  <li class="rounded-xl border border-slate-200 bg-white px-3 py-2 font-mono text-xs text-slate-600"><%= file %></li>
                <% end %>
              </ul>
            <% else %>
              <p class="mt-2 text-slate-500">No version-specific file list yet.</p>
            <% end %>
          </div>

          <div>
            <p class="font-semibold text-slate-900">Code examples</p>
            <% if feature.code_examples_for(version.key).any? %>
              <ul class="mt-2 space-y-1">
                <% feature.code_examples_for(version.key).each do |example| %>
                  <li class="rounded-xl border border-slate-200 bg-white px-3 py-2 font-mono text-xs text-slate-600"><%= example %></li>
                <% end %>
              </ul>
            <% else %>
              <p class="mt-2 text-slate-500">No code example is configured yet.</p>
            <% end %>
          </div>

          <% if feature.operational_notes_for(version.key).any? %>
            <div>
              <p class="font-semibold text-slate-900">Operational notes</p>
              <ul class="mt-2 list-disc space-y-1 pl-5 text-slate-600">
                <% feature.operational_notes_for(version.key).each do |note| %>
                  <li><%= note %></li>
                <% end %>
              </ul>
            </div>
          <% end %>
        </div>
      </article>
    <% end %>
  </div>
</section>
