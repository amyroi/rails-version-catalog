<section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">コード・設定の比較</p>
      <h2 class="mt-1 text-xl font-semibold text-slate-900">ファイルとコード例の違い</h2>
    </div>
    <p class="max-w-2xl text-sm leading-6 text-slate-600">
      バージョンごとのファイル・コード例・運用上の注意を比較します。実際の操作は下のデモで確認できます。
    </p>
  </div>

  <div class="grid gap-4 [grid-template-columns:repeat(auto-fit,minmax(min(100%,16rem),1fr))]">
    <% comparison_versions.each do |version| %>
      <article class="rounded-2xl border border-slate-200 bg-slate-50 p-5 shadow-sm">
        <div class="flex items-start justify-between gap-3">
          <div>
            <h3 class="text-lg font-semibold text-slate-900"><%= version.label %></h3>
            <% if (status = feature.status_for(version.key)).present? %>
              <p class="mt-1 text-sm text-slate-600">バージョン別の特徴: <%= status %></p>
            <% end %>
          </div>
          <% if feature.highlight_for(version.key).present? %>
            <span class="rounded-full bg-white px-2.5 py-1 text-xs font-semibold text-slate-600">注目点</span>
          <% end %>
        </div>

        <div class="mt-4 space-y-4 text-sm text-slate-700">
          <div>
            <p class="font-semibold text-slate-900">関連するファイル・設定</p>
            <% if feature.files_for(version.key).any? %>
              <ul class="mt-2 space-y-1">
                <% feature.files_for(version.key).each do |file| %>
                  <li class="rounded-xl border border-slate-200 bg-white px-3 py-2 break-all font-mono text-xs text-slate-600"><%= file %></li>
                <% end %>
              </ul>
            <% else %>
              <p class="mt-2 text-slate-500">このバージョンのファイル一覧は未登録です。</p>
            <% end %>
          </div>

          <div>
            <p class="font-semibold text-slate-900">コード例</p>
            <% if feature.code_examples_for(version.key).any? %>
              <ul class="mt-2 space-y-1">
                <% feature.code_examples_for(version.key).each do |example| %>
                  <li class="rounded-xl border border-slate-200 bg-white px-3 py-2 break-all font-mono text-xs text-slate-600"><%= example %></li>
                <% end %>
              </ul>
            <% else %>
              <p class="mt-2 text-slate-500">コード例は未登録です。</p>
            <% end %>
          </div>

          <% if feature.operational_notes_for(version.key).any? %>
            <div>
              <p class="font-semibold text-slate-900">運用時の注意</p>
              <ul class="mt-2 list-disc space-y-1 pl-5 text-slate-600">
                <% feature.operational_notes_for(version.key).each do |note| %>
                  <li><%= note %></li>
                <% end %>
              </ul>
            </div>
          <% end %>
        </div>
      </article>
    <% end %>
  </div>
</section>
