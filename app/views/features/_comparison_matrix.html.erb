<section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
  <div class="mb-4 flex items-center justify-between">
    <h2 class="text-xl font-semibold text-slate-900">バージョン別の比較</h2>
    <span class="text-sm text-slate-500"><%= comparison_versions.size %> バージョンを比較中</span>
  </div>

  <div class="grid gap-4 [grid-template-columns:repeat(auto-fit,minmax(min(100%,16rem),1fr))]">
    <% comparison_versions.each do |version| %>
      <article class="rounded-2xl border p-5 shadow-sm <%= version_card_classes(version) %>">
        <div class="flex items-start justify-between gap-3">
          <div>
            <h3 class="text-lg font-semibold text-slate-900"><%= version.label %></h3>
            <p class="mt-1 text-xs text-slate-500"><%= version.release_date %></p>
          </div>
          <% if version.latest? %>
            <span class="rounded-full bg-sky-600 px-2.5 py-1 text-xs font-semibold text-white">比較対象の最新</span>
          <% end %>
        </div>

        <div class="mt-4 space-y-4 text-sm text-slate-700">
          <% if (status = feature.status_for(version.key)).present? %>
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">バージョン別の特徴</p>
              <p class="mt-1"><%= status %></p>
            </div>
          <% end %>

          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">概要</p>
            <p class="mt-1 leading-7 text-slate-700"><%= feature.note_for(version.key) %></p>
          </div>

          <% if feature.highlight_for(version.key).present? %>
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">主な変更点</p>
              <p class="mt-1 rounded-2xl border border-sky-100 bg-white/70 p-3 leading-7 text-slate-700"><%= feature.highlight_for(version.key) %></p>
            </div>
          <% end %>

          <% if feature.files_for(version.key).any? %>
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">関連するファイル・設定</p>
              <ul class="mt-2 space-y-1">
                <% feature.files_for(version.key).each do |file| %>
                  <li class="rounded-xl border border-slate-200 bg-white px-3 py-2 break-all font-mono text-xs text-slate-600"><%= file %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <% if feature.upgrade_notes_for(version.key).any? %>
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">移行時の注意</p>
              <ul class="mt-2 list-disc space-y-1 pl-5 text-slate-600">
                <% feature.upgrade_notes_for(version.key).each do |note| %>
                  <li><%= note %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <% if feature.operational_notes_for(version.key).any? %>
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">補足</p>
              <ul class="mt-2 list-disc space-y-1 pl-5 text-slate-600">
                <% feature.operational_notes_for(version.key).each do |note| %>
                  <li><%= note %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <a href="<%= feature.source_for(version.key) %>" target="_blank" rel="noreferrer" class="inline-flex text-sm text-sky-700 underline underline-offset-4">
            Official source ↗
          </a>
        </div>
      </article>
    <% end %>
  </div>
</section>
