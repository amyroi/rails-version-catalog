<section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
  <div class="mb-4 flex items-center justify-between">
    <h2 class="text-xl font-semibold text-slate-900">Version comparison matrix</h2>
    <span class="text-sm text-slate-500"><%= comparison_versions.size %> versions selected</span>
  </div>

  <div class="grid gap-4 [grid-template-columns:repeat(auto-fit,minmax(16rem,1fr))]">
    <% comparison_versions.each do |version| %>
      <article class="rounded-2xl border p-5 shadow-sm <%= version_card_classes(version) %>">
        <div class="flex items-start justify-between gap-3">
          <div>
            <h3 class="text-lg font-semibold text-slate-900"><%= version.label %></h3>
            <p class="mt-1 text-xs text-slate-500"><%= version.release_date %></p>
          </div>
          <% if version.latest? %>
            <span class="rounded-full bg-sky-600 px-2.5 py-1 text-xs font-semibold text-white">Latest</span>
          <% end %>
        </div>

        <p class="mt-4 text-sm leading-7 text-slate-700"><%= feature.note_for(version.key) %></p>

        <% if feature.highlight_for(version.key).present? %>
          <div class="mt-4 rounded-2xl border border-sky-100 bg-white/70 p-3 text-sm text-slate-700">
            <strong class="text-slate-900">Highlight:</strong> <%= feature.highlight_for(version.key) %>
          </div>
        <% end %>

        <a href="<%= feature.source_for(version.key) %>" target="_blank" rel="noreferrer" class="mt-4 inline-flex text-sm text-sky-700 underline underline-offset-4">
          Official source ↗
        </a>
      </article>
    <% end %>
  </div>
</section>
