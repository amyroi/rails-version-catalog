<div class="grid gap-6 lg:grid-cols-[1.1fr_0.9fr]">
  <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
    <h3 class="text-lg font-semibold"><%= t("demos.auth") %></h3>
    <p class="mt-2 text-sm leading-6 text-slate-600"><%= feature.demo_notes.fetch("description") %></p>

    <div class="mt-5 grid gap-4 md:grid-cols-2">
      <div class="rounded-2xl border border-slate-200 bg-white p-4">
        <p class="text-sm text-slate-500"><%= t("demos.current_status") %></p>
        <% if @current_user %>
          <p class="mt-2 text-lg font-semibold text-emerald-700"><%= t("demos.signed_in", email: @current_user.email_address) %></p>
          <p class="mt-2 text-sm text-slate-600"><%= t("demos.protected_help") %></p>
          <%= link_to t("demos.protected"), auth_lab_path, class: "mt-4 inline-flex rounded-full bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-500" %>
        <% else %>
          <p class="mt-2 text-lg font-semibold text-amber-700"><%= t("demos.not_signedin") %></p>
          <p class="mt-2 text-sm text-slate-600"><%= t("demos.signin_help") %></p>
          <div class="mt-4 flex flex-wrap gap-3">
            <%= link_to t("ui.signin"), new_session_path, class: "rounded-full bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700" %>
            <%= link_to t("ui.create_account"), new_user_path, class: "rounded-full border border-slate-200 bg-white px-4 py-2 text-sm text-slate-700 hover:bg-slate-100" %>
          </div>
        <% end %>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white p-4">
        <p class="text-sm text-slate-500"><%= t("demos.changes") %></p>
        <ul class="mt-3 space-y-2 text-sm text-slate-700">
          <li><%= feature.demo_notes.fetch("detail_2") %></li>
          <li><%= feature.demo_notes.fetch("detail_3") %></li>
          <li><%= feature.demo_notes.fetch("detail_4") %></li>
          <li><%= feature.demo_notes.fetch("detail_5") %></li>
        </ul>
      </div>
    </div>
  </div>

  <aside class="rounded-2xl border border-slate-200 bg-white p-5">
    <h3 class="text-lg font-semibold"><%= t("demos.quick") %></h3>
    <dl class="mt-4 space-y-4 text-sm">
      <div>
        <dt class="text-slate-500"><%= t("demos.account") %></dt>
        <dd class="mt-1 font-mono text-slate-900">demo@example.com / password123</dd>
      </div>
      <div>
        <dt class="text-slate-500"><%= t("demos.destination") %></dt>
        <dd class="mt-1 text-slate-700"><code>/auth_lab</code></dd>
      </div>
      <div>
        <dt class="text-slate-500"><%= t("demos.related") %></dt>
        <dd class="mt-1 text-slate-700">User, Session, Authentication concern, PasswordsMailer</dd>
      </div>
    </dl>
  </aside>
</div>
