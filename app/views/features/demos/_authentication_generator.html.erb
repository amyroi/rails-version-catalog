<div class="grid gap-6 lg:grid-cols-[1.1fr_0.9fr]">
  <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
    <h3 class="text-lg font-semibold"><%= t("demos.auth.heading") %></h3>
    <p class="mt-2 text-sm leading-6 text-slate-600"><%= catalog_note(feature, "description") %></p>

    <div class="mt-5 grid gap-4 md:grid-cols-2">
      <div class="rounded-2xl border border-slate-200 bg-white p-4">
        <p class="text-sm text-slate-500"><%= t("demos.auth.status") %></p>
        <% if @current_user %>
          <p class="mt-2 text-lg font-semibold text-emerald-700"><%= t("demos.auth.signed_in", email: @current_user.email_address) %></p>
          <p class="mt-2 text-sm text-slate-600"><%= t("demos.auth.protected_description") %></p>
          <%= link_to t("demos.auth.open_protected"), auth_lab_path, class: "mt-4 inline-flex rounded-full bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-500" %>
        <% else %>
          <p class="mt-2 text-lg font-semibold text-amber-700"><%= t("demos.auth.signed_out") %></p>
          <p class="mt-2 text-sm text-slate-600"><%= t("demos.auth.sign_in_description") %></p>
          <div class="mt-4 flex flex-wrap gap-3">
            <%= link_to t("common.sign_in"), new_session_path, class: "rounded-full bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700" %>
            <%= link_to t("common.create_account"), new_user_path, class: "rounded-full border border-slate-200 bg-white px-4 py-2 text-sm text-slate-700 hover:bg-slate-100" %>
          </div>
        <% end %>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white p-4">
        <p class="text-sm text-slate-500"><%= t("demos.auth.code_changes") %></p>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-sm text-slate-700">
          <li><%= catalog_note(feature, "generate") %></li>
          <li><%= catalog_note(feature, "session_cookie") %></li>
          <li><%= catalog_note(feature, "normalize") %></li>
          <li><%= catalog_note(feature, "rate_limit") %></li>
        </ul>
      </div>
    </div>
  </div>

  <aside class="rounded-2xl border border-slate-200 bg-white p-5">
    <h3 class="text-lg font-semibold"><%= t("common.try_it") %></h3>
    <dl class="mt-4 space-y-4 text-sm">
      <div>
        <dt class="text-slate-500"><%= t("common.demo_account") %></dt>
        <dd class="mt-1 font-mono text-slate-900">demo@example.com / password123</dd>
      </div>
      <div>
        <dt class="text-slate-500"><%= t("demos.auth.destination") %></dt>
        <dd class="mt-1 text-slate-700"><code>/auth_lab</code></dd>
      </div>
      <div>
        <dt class="text-slate-500"><%= t("common.related_files") %></dt>
        <dd class="mt-1 text-slate-700"><%= catalog_note(feature, "files") %></dd>
      </div>
    </dl>
  </aside>
</div>
