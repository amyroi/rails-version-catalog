<div class="grid gap-4 md:grid-cols-2">
  <article class="min-w-0 rounded-2xl border border-slate-200 bg-slate-50 p-5">
    <p class="text-sm text-slate-500"><%= t("demos.repo") %></p>
    <ul class="mt-4 space-y-3 text-sm text-slate-700">
      <li><%= t("demos.kamal_config") %> <strong><%= @repo_facts[:kamal_config] ? "present" : "missing" %></strong></li>
      <li><%= t("demos.kamal_secrets") %> <strong><%= @repo_facts[:kamal_secrets] ? "present" : "missing" %></strong></li>
      <li>Dockerfile: <strong><%= @repo_facts[:dockerfile] ? "present" : "missing" %></strong></li>
    </ul>
  </article>

  <article class="min-w-0 rounded-2xl border border-slate-200 bg-white p-5">
    <p class="text-sm text-slate-500"><%= t("demos.rails81") %></p>
    <p class="mt-2 text-sm leading-7 text-slate-700"><%= feature.demo_notes.fetch("description") %></p>
  </article>
</div>
