<div class="grid gap-4 md:grid-cols-2">
  <article class="min-w-0 rounded-2xl border border-slate-200 bg-slate-50 p-5">
    <h3 class="text-lg font-semibold"><%= t("demos.docker.heading") %></h3>
    <ul class="mt-4 space-y-3 text-sm text-slate-700">
      <li><%= t("demos.facts.dockerfile_html", state: @repo_facts[:dockerfile] ? t("common.present") : t("common.missing")) %></li>
      <li><%= t("demos.facts.github_actions_html", state: @repo_facts[:github_actions] ? t("common.present") : t("common.missing")) %></li>
      <li><%= t("demos.facts.kamal_deploy_html", state: @repo_facts[:kamal_config] ? t("common.present") : t("common.missing")) %></li>
    </ul>
  </article>

  <article class="min-w-0 rounded-2xl border border-slate-200 bg-slate-50 p-5">
    <h3 class="text-lg font-semibold"><%= t("demos.docker.comparison") %></h3>
    <p class="mt-4 text-sm leading-7 text-slate-700"><%= feature.summary %></p>
  </article>
</div>
