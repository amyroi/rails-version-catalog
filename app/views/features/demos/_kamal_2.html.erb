<div class="grid gap-4 md:grid-cols-2">
  <article class="min-w-0 rounded-2xl border border-slate-200 bg-slate-50 p-5">
    <p class="text-sm text-slate-500"><%= t("demos.app_facts") %></p>
    <ul class="mt-4 space-y-3 text-sm text-slate-700">
      <li><%= t("demos.facts.kamal_gem_html", state: @repo_facts[:kamal] ? t("common.present") : t("common.missing")) %></li>
      <li><%= t("demos.facts.deploy_file_plain_html", state: @repo_facts[:kamal_config] ? t("common.present") : t("common.missing")) %></li>
      <li><%= t("demos.facts.secrets_file_plain_html", state: @repo_facts[:kamal_secrets] ? t("common.present") : t("common.missing")) %></li>
    </ul>
  </article>

  <article class="min-w-0 rounded-2xl border border-slate-200 bg-slate-50 p-5">
    <p class="text-sm text-slate-500"><%= t("demos.kamal.rails8_heading") %></p>
    <p class="mt-2 text-sm leading-7 text-slate-700"><%= feature.summary %></p>
  </article>
</div>
