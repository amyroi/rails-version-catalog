<div class="grid gap-4 md:grid-cols-2">
  <article class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
    <p class="text-sm text-slate-500"><%= t("demos.repo_facts") %></p>
    <ul class="mt-4 space-y-3 text-sm text-slate-700">
      <li>GitHub Actions workflow: <strong><%= @repo_facts[:github_actions] ? "present" : "missing" %></strong></li>
      <li><code>config/ci.rb</code>: <strong><%= Rails.root.join("config/ci.rb").exist? ? "present" : "missing" %></strong></li>
      <li><code>bin/ci</code>: <strong><%= Rails.root.join("bin/ci").exist? ? "present" : "missing" %></strong></li>
    </ul>
  </article>

  <article class="rounded-2xl border border-slate-200 bg-white p-5">
    <p class="text-sm text-slate-500"><%= t("demos.comparison") %></p>
    <p class="mt-2 text-sm leading-7 text-slate-700"><%= feature.demo_notes.fetch("description") %></p>
  </article>
</div>
