<div class="grid gap-4 md:grid-cols-2">
  <article class="min-w-0 rounded-2xl border border-slate-200 bg-slate-50 p-5">
    <h3 class="text-lg font-semibold text-slate-900"><%= t("demos.markdown.heading") %></h3>
    <p class="mt-3 text-sm leading-7 text-slate-700"><%= catalog_note(feature, "description") %></p>
  </article>

  <article class="min-w-0 rounded-2xl border border-slate-200 bg-white p-5">
    <h3 class="text-lg font-semibold text-slate-900"><%= t("demos.markdown.example") %></h3>
    <pre class="mt-3 overflow-x-auto rounded-2xl border border-slate-200 bg-slate-950 p-4 text-xs leading-6 text-slate-100"><code># Release summary

- queue: Solid Queue
- cache: Solid Cache
- cable: Solid Cable</code></pre>
    <p class="mt-3 text-sm text-slate-600"><%= t("demos.markdown.future") %></p>
  </article>
</div>
