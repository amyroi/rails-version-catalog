<div class="grid gap-4 md:grid-cols-2">
  <article class="min-w-0 rounded-2xl border border-slate-200 bg-slate-50 p-5">
    <p class="text-sm text-slate-500"><%= t("demos.gem_presence") %></p>
    <p class="mt-2 text-lg font-semibold text-slate-900"><%= @repo_facts[:propshaft] ? t("demos.propshaft.present") : t("demos.propshaft.missing") %></p>
    <p class="mt-4 text-sm leading-7 text-slate-700"><%= catalog_note(feature, "description") %></p>
  </article>

  <article class="min-w-0 rounded-2xl border border-slate-200 bg-slate-50 p-5">
    <p class="text-sm text-slate-500"><%= t("demos.propshaft.comparison") %></p>
    <ul class="mt-3 list-disc space-y-2 pl-5 text-sm text-slate-700">
      <li><%= catalog_note(feature, "sprockets") %></li>
      <li><%= catalog_note(feature, "fingerprint") %></li>
      <li><%= catalog_note(feature, "importmap") %></li>
    </ul>
  </article>
</div>
