<div class="grid gap-4 md:grid-cols-2">
  <article class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
    <p class="text-sm text-slate-500"><%= t("demos.gem") %></p>
    <p class="mt-2 text-lg font-semibold text-slate-900"><%= @repo_facts[:propshaft] ? "Propshaft enabled" : "Propshaft missing" %></p>
    <p class="mt-4 text-sm leading-7 text-slate-700"><%= feature.demo_notes.fetch("description") %></p>
  </article>

  <article class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
    <p class="text-sm text-slate-500"><%= t("demos.compare") %></p>
    <ul class="mt-3 space-y-2 text-sm text-slate-700">
      <li><%= feature.demo_notes.fetch("detail_2") %></li>
      <li><%= feature.demo_notes.fetch("detail_3") %></li>
      <li><%= feature.demo_notes.fetch("detail_4") %></li>
    </ul>
  </article>
</div>
