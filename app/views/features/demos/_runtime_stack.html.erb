<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
  <article class="min-w-0 rounded-2xl border border-slate-200 bg-slate-50 p-5">
    <p class="text-sm text-slate-500"><%= t("demos.stack.job_adapter") %></p>
    <p class="mt-2 text-lg font-semibold text-slate-900"><%= @stack_facts[:queue_adapter] %></p>
  </article>

  <article class="min-w-0 rounded-2xl border border-slate-200 bg-slate-50 p-5">
    <p class="text-sm text-slate-500"><%= t("demos.stack.cache_store") %></p>
    <p class="mt-2 text-lg font-semibold text-slate-900"><%= @stack_facts[:cache_store] %></p>
  </article>

  <article class="min-w-0 rounded-2xl border border-slate-200 bg-slate-50 p-5">
    <p class="text-sm text-slate-500"><%= t("demos.stack.cable_adapter") %></p>
    <p class="mt-2 text-lg font-semibold text-slate-900"><%= @stack_facts[:cable_adapter] %></p>
  </article>

  <article class="min-w-0 rounded-2xl border border-slate-200 bg-slate-50 p-5">
    <p class="text-sm text-slate-500"><%= t("demos.stack.authentication") %></p>
    <p class="mt-2 text-lg font-semibold text-slate-900"><%= @stack_facts[:auth_enabled] ? t("common.yes") : t("common.no") %></p>
  </article>

  <article class="min-w-0 rounded-2xl border border-slate-200 bg-slate-50 p-5">
    <p class="text-sm text-slate-500"><%= t("common.jobs_count") %></p>
    <p class="mt-2 text-lg font-semibold text-slate-900"><%= @stack_facts[:queue_runs] %></p>
  </article>

  <article class="min-w-0 rounded-2xl border border-slate-200 bg-slate-50 p-5">
    <p class="text-sm text-slate-500"><%= t("common.messages_count") %></p>
    <p class="mt-2 text-lg font-semibold text-slate-900"><%= @stack_facts[:live_messages] %></p>
  </article>
</div>

<div class="mt-6 rounded-2xl border border-slate-200 bg-slate-50 p-5 text-sm leading-7 text-slate-700">
  <%= t("demos.stack.description") %>
</div>
