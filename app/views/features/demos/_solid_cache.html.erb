<div class="grid gap-6 lg:grid-cols-[0.95fr_1.05fr]">
  <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
    <h3 class="text-lg font-semibold"><%= t("demos.cache.heading") %></h3>
    <div class="mt-4 inline-flex rounded-full px-3 py-1 text-xs font-semibold <%= cache_state_classes(@cache_snapshot[:hit]) %>">
      <%= @cache_snapshot[:hit] ? t("demos.cache.hit") : t("demos.cache.miss") %>
    </div>

    <dl class="mt-5 space-y-3 text-sm">
      <div>
        <dt class="text-slate-500"><%= t("demos.cache.store") %></dt>
        <dd class="mt-1 text-slate-900"><%= @cache_snapshot[:store] %></dd>
      </div>
      <div>
        <dt class="text-slate-500"><%= t("demos.cache.key") %></dt>
        <dd class="mt-1 break-all font-mono text-slate-900"><%= @cache_snapshot[:key] %></dd>
      </div>
      <div>
        <dt class="text-slate-500"><%= t("demos.cache.generated_at") %></dt>
        <dd class="mt-1 text-slate-900"><%= l(Time.iso8601(@cache_snapshot[:payload][:generated_at]), format: :catalog) %></dd>
      </div>
      <div>
        <dt class="text-slate-500"><%= t("demos.cache.checksum") %></dt>
        <dd class="mt-1 font-mono text-slate-900"><%= @cache_snapshot[:payload][:checksum] %></dd>
      </div>
    </dl>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
    <h3 class="text-lg font-semibold"><%= t("common.try_it") %></h3>
    <p class="mt-2 text-sm leading-6 text-slate-600"><%= t("demos.cache.instructions", refresh: t("demos.cache.refresh"), clear: t("demos.cache.clear")) %></p>

    <div class="mt-5 flex flex-wrap gap-3">
      <%= button_to t("demos.cache.refresh"), refresh_cache_demo_path(compare: params[:compare]), method: :post, class: "rounded-full bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700" %>
      <%= button_to t("demos.cache.clear"), cache_demo_path(compare: params[:compare]), method: :delete, class: "rounded-full border border-slate-200 bg-white px-4 py-2 text-sm text-slate-700 hover:bg-slate-100" %>
      <%= link_to t("demos.cache.reload"), feature_path("solid-cache", compare: params[:compare]), class: "rounded-full border border-slate-200 bg-white px-4 py-2 text-sm text-slate-700 hover:bg-slate-100" %>
    </div>

    <div class="mt-5 rounded-2xl border border-slate-200 bg-white p-4 text-sm text-slate-700">
      <p class="font-semibold text-slate-900"><%= t("demos.cache.explanation") %></p>
      <p class="mt-2"><%= t("cache_demo.explanation") %></p>
    </div>
  </div>
</div>
