<div class="grid gap-6 lg:grid-cols-[0.95fr_1.05fr]">
  <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
    <h3 class="text-lg font-semibold"><%= t("demos.queue.heading") %></h3>
    <p class="mt-2 text-sm leading-6 text-slate-600"><%= catalog_note(feature, "description") %></p>

    <%= form_with model: @queue_run, class: "mt-5 space-y-4" do |form| %>
      <%= hidden_field_tag :compare, params[:compare] if params[:compare].present? %>
      <div>
        <%= form.label :input, class: "text-sm text-slate-600" %>
        <%= form.text_field :input, class: "mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900" %>
      </div>

      <%= form.submit t("demos.queue.submit"), class: "rounded-full bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700" %>
    <% end %>

    <div class="mt-5 rounded-2xl border border-slate-200 bg-white p-4 text-sm text-slate-700">
      <p class="font-semibold text-slate-900"><%= t("demos.queue.instructions") %></p>
      <ul class="mt-2 space-y-2">
        <li><%= t("demos.queue.enqueue") %></li>
        <li><%= t("demos.queue.working_html") %></li>
        <li><%= t("demos.queue.completed_html") %></li>
      </ul>
    </div>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
    <div class="flex items-center justify-between">
      <h3 class="text-lg font-semibold"><%= t("demos.queue.recent") %></h3>
      <span class="text-sm text-slate-500"><%= t("common.shown_count", count: @queue_runs.size) %></span>
    </div>

    <%= turbo_stream_from "solid_queue_runs" %>
    <div id="solid_queue_runs" class="mt-5 space-y-3">
      <%= render @queue_runs %>
    </div>
  </div>
</div>
