<% content_for :title, "Feature Index" %>

<div class="mb-8">
  <p class="text-sm uppercase tracking-[0.2em] text-sky-600">Feature Index</p>
  <h1 class="mt-3 text-3xl font-semibold tracking-tight text-slate-900"><%= catalog_version_heading(@comparison_versions.map(&:key)) %> の差分をカテゴリ別に一覧表示</h1>
  <p class="mt-3 max-w-3xl text-slate-600">比較対象バージョンを固定配列ではなく selector で扱い、将来 9.x を追加しやすい構造に寄せています。</p>
</div>

<div class="mb-8 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
  <div class="flex flex-wrap items-center gap-3">
    <span class="text-sm font-semibold text-slate-700">Compare versions:</span>
    <% @versions.each do |version| %>
      <%= link_to version.label, features_path(compare: compare_query_value([ version.key ])), class: version_chip_classes(version, active: @comparison_versions.map(&:key).include?(version.key)) %>
    <% end %>
    <%= link_to "Show all", features_path(compare: compare_query_value(VersionCatalog.default_compare_keys)), class: "rounded-full border border-slate-200 bg-slate-900 px-4 py-2 text-xs font-semibold text-white hover:bg-slate-700" %>
  </div>
</div>

<section class="grid gap-8 lg:grid-cols-2">
  <div class="space-y-4">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-xl font-semibold">Interactive demos</h2>
        <p class="mt-1 text-sm text-slate-600">現在の <%= current_runtime_label %> runtime 上で確認できる live demo です。</p>
      </div>
      <span class="text-sm text-slate-500"><%= @runtime_features.size %> entries</span>
    </div>

    <% @runtime_features.each do |feature| %>
      <article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
        <span class="<%= feature_badge_classes(feature) %>"><%= feature.category_label %></span>
        <h3 class="mt-4 text-xl font-semibold text-slate-900"><%= feature.title %></h3>
        <p class="mt-3 text-sm leading-6 text-slate-600"><%= feature.summary %></p>
        <div class="mt-4 flex flex-wrap gap-2">
          <% feature.comparison_versions(@comparison_versions.map(&:key)).each do |version| %>
            <span class="<%= version_chip_classes(version, active: version.latest?) %>"><%= version.label %></span>
          <% end %>
        </div>
        <p class="mt-4 rounded-2xl border border-sky-100 bg-sky-50 p-4 text-sm text-slate-700"><strong class="text-slate-900">Latest focus:</strong> <%= feature.highlight_for(feature.latest_version_key) %></p>
        <%= link_to "Open feature", feature_path(feature.slug, compare: compare_query_value(@comparison_versions.map(&:key))), class: "mt-5 inline-flex rounded-full border border-slate-200 bg-white px-4 py-2 text-sm text-slate-700 hover:bg-slate-100" %>
      </article>
    <% end %>
  </div>

  <div class="space-y-4">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-xl font-semibold">Config / platform differences</h2>
        <p class="mt-1 text-sm text-slate-600"><%= catalog_version_heading(@comparison_versions.map(&:key)) %> の設定・標準構成・運用差分を比較します。</p>
      </div>
      <span class="text-sm text-slate-500"><%= @platform_features.size %> entries</span>
    </div>

    <% @platform_features.each do |feature| %>
      <article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
        <span class="<%= feature_badge_classes(feature) %>"><%= feature.category_label %></span>
        <h3 class="mt-4 text-xl font-semibold text-slate-900"><%= feature.title %></h3>
        <p class="mt-3 text-sm leading-6 text-slate-600"><%= feature.summary %></p>
        <div class="mt-4 flex flex-wrap gap-2">
          <% feature.comparison_versions(@comparison_versions.map(&:key)).each do |version| %>
            <span class="<%= version_chip_classes(version, active: version.latest?) %>"><%= version.label %></span>
          <% end %>
        </div>
        <p class="mt-4 rounded-2xl border border-sky-100 bg-sky-50 p-4 text-sm text-slate-700"><strong class="text-slate-900">Latest focus:</strong> <%= feature.highlight_for(feature.latest_version_key) %></p>
        <%= link_to "Open comparison", feature_path(feature.slug, compare: compare_query_value(@comparison_versions.map(&:key))), class: "mt-5 inline-flex rounded-full border border-slate-200 bg-white px-4 py-2 text-sm text-slate-700 hover:bg-slate-100" %>
      </article>
    <% end %>
  </div>
</section>
