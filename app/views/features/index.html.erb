<% content_for :title, t("features.index.title") %>

<div class="mb-8">
  <p class="text-sm uppercase tracking-[0.2em] text-sky-600"><%= t("features.index.title") %></p>
  <h1 class="mt-3 break-words text-3xl font-semibold tracking-tight text-slate-900"><%= t("features.index.heading", versions: catalog_version_heading(@comparison_versions.map(&:key))) %></h1>
  <p class="mt-3 max-w-3xl text-slate-600"><%= t("features.index.description") %></p>
</div>

<div class="mb-8 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
  <div class="flex flex-wrap items-center gap-3">
    <span class="text-sm font-semibold text-slate-700"><%= t("features.index.compare") %></span>
    <% @versions.each do |version| %>
      <%= link_to version.label, features_path(compare: compare_query_value([ version.key ])), class: version_chip_classes(version, active: @comparison_versions.map(&:key).include?(version.key)) %>
    <% end %>
    <%= link_to t("common.show_all"), features_path(compare: compare_query_value(VersionCatalog.default_compare_keys)), class: "rounded-full border border-slate-200 bg-slate-900 px-4 py-2 text-xs font-semibold text-white hover:bg-slate-700" %>
  </div>
</div>

<section class="grid gap-8 lg:grid-cols-2">
  <div class="space-y-4">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <h2 class="text-xl font-semibold"><%= t("common.runtime_demos") %></h2>
        <p class="mt-1 text-sm text-slate-600"><%= t("features.index.runtime_description", runtime: current_runtime_label) %></p>
      </div>
      <span class="text-sm text-slate-500"><%= t("common.entry_count", count: @runtime_features.size) %></span>
    </div>

    <% @runtime_features.each do |feature| %>
      <article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
        <span class="<%= feature_badge_classes(feature) %>"><%= feature.category_label %></span>
        <h3 class="mt-4 text-xl font-semibold text-slate-900"><%= feature.title %></h3>
        <p class="mt-3 text-sm leading-6 text-slate-600"><%= feature.summary %></p>
        <div class="mt-4 flex flex-wrap gap-2">
          <% feature.comparison_versions(@comparison_versions.map(&:key)).each do |version| %>
            <span class="<%= version_chip_classes(version, active: version.latest?) %>"><%= version.label %></span>
          <% end %>
        </div>
        <p class="mt-4 rounded-2xl border border-sky-100 bg-sky-50 p-4 text-sm text-slate-700"><%= t("features.highlight_value_html", label: t("features.latest_highlight"), highlight: feature.highlight_for(feature.latest_version_key)) %></p>
        <%= link_to t("features.index.open_feature"), feature_path(feature.slug, compare: compare_query_value(@comparison_versions.map(&:key))), class: "mt-5 inline-flex rounded-full border border-slate-200 bg-white px-4 py-2 text-sm text-slate-700 hover:bg-slate-100" %>
      </article>
    <% end %>
  </div>

  <div class="space-y-4">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <h2 class="text-xl font-semibold"><%= t("common.platform_differences") %></h2>
        <p class="mt-1 text-sm text-slate-600"><%= t("features.index.platform_description", versions: catalog_version_heading(@comparison_versions.map(&:key))) %></p>
      </div>
      <span class="text-sm text-slate-500"><%= t("common.entry_count", count: @platform_features.size) %></span>
    </div>

    <% @platform_features.each do |feature| %>
      <article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
        <span class="<%= feature_badge_classes(feature) %>"><%= feature.category_label %></span>
        <h3 class="mt-4 text-xl font-semibold text-slate-900"><%= feature.title %></h3>
        <p class="mt-3 text-sm leading-6 text-slate-600"><%= feature.summary %></p>
        <div class="mt-4 flex flex-wrap gap-2">
          <% feature.comparison_versions(@comparison_versions.map(&:key)).each do |version| %>
            <span class="<%= version_chip_classes(version, active: version.latest?) %>"><%= version.label %></span>
          <% end %>
        </div>
        <p class="mt-4 rounded-2xl border border-sky-100 bg-sky-50 p-4 text-sm text-slate-700"><%= t("features.highlight_value_html", label: t("features.latest_highlight"), highlight: feature.highlight_for(feature.latest_version_key)) %></p>
        <%= link_to t("features.index.open_comparison"), feature_path(feature.slug, compare: compare_query_value(@comparison_versions.map(&:key))), class: "mt-5 inline-flex rounded-full border border-slate-200 bg-white px-4 py-2 text-sm text-slate-700 hover:bg-slate-100" %>
      </article>
    <% end %>
  </div>
</section>
