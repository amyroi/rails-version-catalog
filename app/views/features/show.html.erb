<% content_for :title, @feature.title %>

<div class="space-y-8">
  <section class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">Overview</p>
        <span class="<%= feature_badge_classes(@feature) %>"><%= @feature.category_label %></span>
        <h1 class="mt-4 text-3xl font-semibold tracking-tight text-slate-900"><%= @feature.title %></h1>
        <p class="mt-3 text-base leading-7 text-slate-600"><%= @feature.summary %></p>
        <div class="mt-4 flex flex-wrap gap-2">
          <% @feature.available_versions.each do |version| %>
            <%= link_to version.label, feature_path(@feature.slug, compare: compare_query_value([ version.key ])), class: version_chip_classes(version, active: @comparison_versions.map(&:key).include?(version.key)) %>
          <% end %>
          <%= link_to "Show all", feature_path(@feature.slug, compare: compare_query_value(@feature.supported_versions)), class: "rounded-full border border-slate-200 bg-slate-900 px-4 py-2 text-xs font-semibold text-white hover:bg-slate-700" %>
        </div>
      </div>

      <div class="rounded-2xl border border-sky-200 bg-sky-50 px-4 py-3 text-sm text-sky-900">
        <p class="font-semibold">Latest highlight</p>
        <p class="mt-1 max-w-sm text-slate-700"><%= @feature.highlight_for(@feature.latest_version_key) %></p>
      </div>
    </div>
  </section>

  <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="mb-4 flex items-center justify-between">
      <h2 class="text-xl font-semibold text-slate-900">Version comparison matrix</h2>
      <span class="text-sm text-slate-500"><%= @comparison_versions.size %> versions selected</span>
    </div>

    <div class="grid gap-4 [grid-template-columns:repeat(auto-fit,minmax(16rem,1fr))]">
      <% @comparison_versions.each do |version| %>
        <article class="rounded-2xl border p-5 shadow-sm <%= version_card_classes(version) %>">
          <div class="flex items-start justify-between gap-3">
            <div>
              <h3 class="text-lg font-semibold text-slate-900"><%= version.label %></h3>
              <p class="mt-1 text-xs text-slate-500"><%= version.release_date %></p>
            </div>
            <% if version.latest? %>
              <span class="rounded-full bg-sky-600 px-2.5 py-1 text-xs font-semibold text-white">Latest</span>
            <% end %>
          </div>

          <div class="mt-4 space-y-4 text-sm text-slate-700">
            <% if (status = @feature.status_for(version.key)).present? %>
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Status</p>
                <p class="mt-1"><%= status %></p>
              </div>
            <% end %>

            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Summary</p>
              <p class="mt-1 leading-7 text-slate-700"><%= @feature.note_for(version.key) %></p>
            </div>

            <% if @feature.highlight_for(version.key).present? %>
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Key changes</p>
                <p class="mt-1 rounded-2xl border border-sky-100 bg-white/70 p-3 leading-7 text-slate-700"><%= @feature.highlight_for(version.key) %></p>
              </div>
            <% end %>

            <% if @feature.files_for(version.key).any? %>
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Files / config involved</p>
                <ul class="mt-2 space-y-1">
                  <% @feature.files_for(version.key).each do |file| %>
                    <li class="rounded-xl border border-slate-200 bg-white px-3 py-2 font-mono text-xs text-slate-600"><%= file %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <% if @feature.upgrade_notes_for(version.key).any? %>
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Upgrade impact</p>
                <ul class="mt-2 list-disc space-y-1 pl-5 text-slate-600">
                  <% @feature.upgrade_notes_for(version.key).each do |note| %>
                    <li><%= note %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <% if @feature.operational_notes_for(version.key).any? %>
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Notes</p>
                <ul class="mt-2 list-disc space-y-1 pl-5 text-slate-600">
                  <% @feature.operational_notes_for(version.key).each do |note| %>
                    <li><%= note %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <a href="<%= @feature.source_for(version.key) %>" target="_blank" rel="noreferrer" class="inline-flex text-sm text-sky-700 underline underline-offset-4">
              Official source ↗
            </a>
          </div>
        </article>
      <% end %>
    </div>
  </section>

  <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">Code / config diff</p>
        <h2 class="mt-1 text-xl font-semibold text-slate-900">What changes in files and examples</h2>
      </div>
      <p class="max-w-2xl text-sm leading-6 text-slate-600">
        This section groups the version-specific files, snippets, and operational notes so the comparison stays separate from the live demo below.
      </p>
    </div>

    <div class="grid gap-4 [grid-template-columns:repeat(auto-fit,minmax(16rem,1fr))]">
      <% @comparison_versions.each do |version| %>
        <article class="rounded-2xl border border-slate-200 bg-slate-50 p-5 shadow-sm">
          <div class="flex items-start justify-between gap-3">
            <div>
              <h3 class="text-lg font-semibold text-slate-900"><%= version.label %></h3>
              <% if (status = @feature.status_for(version.key)).present? %>
                <p class="mt-1 text-sm text-slate-600">Status: <%= status %></p>
              <% end %>
            </div>
            <% if @feature.highlight_for(version.key).present? %>
              <span class="rounded-full bg-white px-2.5 py-1 text-xs font-semibold text-slate-600">Focused</span>
            <% end %>
          </div>

          <div class="mt-4 space-y-4 text-sm text-slate-700">
            <div>
              <p class="font-semibold text-slate-900">Files / config involved</p>
              <% if @feature.files_for(version.key).any? %>
                <ul class="mt-2 space-y-1">
                  <% @feature.files_for(version.key).each do |file| %>
                    <li class="rounded-xl border border-slate-200 bg-white px-3 py-2 font-mono text-xs text-slate-600"><%= file %></li>
                  <% end %>
                </ul>
              <% else %>
                <p class="mt-2 text-slate-500">No version-specific file list yet.</p>
              <% end %>
            </div>

            <div>
              <p class="font-semibold text-slate-900">Code examples</p>
              <% if @feature.code_examples_for(version.key).any? %>
                <ul class="mt-2 space-y-1">
                  <% @feature.code_examples_for(version.key).each do |example| %>
                    <li class="rounded-xl border border-slate-200 bg-white px-3 py-2 font-mono text-xs text-slate-600"><%= example %></li>
                  <% end %>
                </ul>
              <% else %>
                <p class="mt-2 text-slate-500">No code example is configured yet.</p>
              <% end %>
            </div>

            <% if @feature.operational_notes_for(version.key).any? %>
              <div>
                <p class="font-semibold text-slate-900">Operational notes</p>
                <ul class="mt-2 list-disc space-y-1 pl-5 text-slate-600">
                  <% @feature.operational_notes_for(version.key).each do |note| %>
                    <li><%= note %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
  </section>

  <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="mb-6 flex items-center justify-between">
      <h2 class="text-xl font-semibold text-slate-900">Live demo (current runtime: <%= current_runtime_label %>)</h2>
      <a href="<%= @feature.source_url %>" target="_blank" rel="noreferrer" class="text-sm text-sky-700 underline underline-offset-4">Official source ↗</a>
    </div>

    <%= render "features/demos/#{@feature.partial_name}" %>
  </section>

  <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">Upgrade notes</p>
        <h2 class="mt-1 text-xl font-semibold text-slate-900">What to check before upgrading</h2>
      </div>
      <p class="max-w-2xl text-sm leading-6 text-slate-600">
        This section keeps migration guidance separate from the comparison matrix so the upgrade path is easier to scan.
      </p>
    </div>

    <div class="grid gap-4 [grid-template-columns:repeat(auto-fit,minmax(16rem,1fr))]">
      <% @comparison_versions.each do |version| %>
        <article class="rounded-2xl border border-slate-200 bg-slate-50 p-5 shadow-sm">
          <h3 class="text-lg font-semibold text-slate-900"><%= version.label %></h3>

          <% if @feature.upgrade_notes_for(version.key).any? %>
            <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-slate-700">
              <% @feature.upgrade_notes_for(version.key).each do |note| %>
                <li><%= note %></li>
              <% end %>
            </ul>
          <% else %>
            <p class="mt-3 text-sm text-slate-500">No upgrade notes are configured yet.</p>
          <% end %>

          <% if @feature.note_for(version.key).present? %>
            <p class="mt-4 rounded-2xl border border-slate-200 bg-white p-4 text-sm leading-6 text-slate-700"><%= @feature.note_for(version.key) %></p>
          <% end %>
        </article>
      <% end %>
    </div>
  </section>
</div>
