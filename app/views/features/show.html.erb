<% content_for :title, @feature.title %>

<div class="space-y-8">
  <section class="rounded-3xl border border-white/10 bg-slate-900 p-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="max-w-3xl">
        <span class="<%= feature_badge_classes(@feature) %>"><%= @feature.category_label %></span>
        <h1 class="mt-4 text-3xl font-semibold tracking-tight"><%= @feature.title %></h1>
        <p class="mt-3 text-base leading-7 text-slate-300"><%= @feature.summary %></p>
      </div>

      <div class="rounded-2xl border border-sky-400/20 bg-sky-400/10 px-4 py-3 text-sm text-sky-100">
        <p class="font-semibold">Rails 8 highlight</p>
        <p class="mt-1 max-w-sm text-sky-50"><%= @feature.highlight %></p>
      </div>
    </div>
  </section>

  <section class="grid gap-6 lg:grid-cols-2">
    <article class="rounded-3xl border border-white/10 bg-slate-900 p-6">
      <h2 class="text-lg font-semibold text-slate-100">Rails 7.2</h2>
      <p class="mt-3 text-sm leading-7 text-slate-400"><%= @feature.rails_72 %></p>
    </article>

    <article class="rounded-3xl border border-emerald-400/20 bg-emerald-400/10 p-6">
      <h2 class="text-lg font-semibold text-emerald-50">Rails 8.0</h2>
      <p class="mt-3 text-sm leading-7 text-emerald-50/90"><%= @feature.rails_80 %></p>
    </article>
  </section>

  <section class="rounded-3xl border border-white/10 bg-slate-900 p-6">
    <div class="mb-6 flex items-center justify-between">
      <h2 class="text-xl font-semibold">Demo / comparison panel</h2>
      <a href="<%= @feature.source_url %>" target="_blank" rel="noreferrer" class="text-sm text-sky-300 underline underline-offset-4">Official source ↗</a>
    </div>

    <%= render "features/demos/#{@feature.partial_name}" %>
  </section>
</div>
