<% content_for :title, "Rails Version Catalog" %>

<section class="grid gap-8 lg:grid-cols-[1.4fr_0.8fr]">
  <div class="rounded-3xl border border-sky-100 bg-gradient-to-br from-white via-sky-50 to-indigo-50 p-8 shadow-sm">
    <p class="mb-3 text-sm uppercase tracking-[0.2em] text-sky-600">Rails version catalog</p>
    <h1 class="break-words text-4xl font-semibold tracking-tight text-slate-900"><%= t("pages.home_heading", versions: catalog_version_heading(@versions.map(&:key))) %></h1>
    <p class="mt-4 max-w-3xl text-base leading-7 text-slate-600">
      <%= t("pages.home_intro", versions: catalog_version_heading(@versions.map(&:key))) %>
    </p>

    <div class="mt-6 flex flex-wrap gap-2">
      <% @versions.each do |version| %>
        <span class="<%= version_chip_classes(version, active: version.latest?) %>">
          <%= version.label %>
        </span>
      <% end %>
    </div>

    <div class="mt-8 flex flex-wrap gap-3">
      <%= link_to t("pages.list_link"), features_path(compare: compare_query_value(VersionCatalog.default_compare_keys)), class: "rounded-full bg-slate-900 px-5 py-3 text-sm font-semibold text-white hover:bg-slate-700" %>
      <%= link_to t("pages.auth_demo"), feature_path("authentication-generator", compare: compare_query_value(VersionCatalog.default_compare_keys)), class: "rounded-full border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-100" %>
      <%= link_to "Active Job Continuations", feature_path("active-job-continuations", compare: compare_query_value(VersionCatalog.default_compare_keys)), class: "rounded-full border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-100" %>
    </div>
  </div>

  <aside class="grid gap-4">
    <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
      <p class="text-sm text-slate-500"><%= t("pages.coverage") %></p>
      <dl class="mt-4 space-y-4">
        <div class="flex items-center justify-between">
          <dt class="text-slate-600"><%= t("pages.interactive") %></dt>
          <dd class="text-2xl font-semibold text-slate-900"><%= @runtime_features.size %></dd>
        </div>
        <div class="flex items-center justify-between">
          <dt class="text-slate-600"><%= t("pages.config_diffs") %></dt>
          <dd class="text-2xl font-semibold text-slate-900"><%= @platform_features.size %></dd>
        </div>
        <div class="flex items-center justify-between">
          <dt class="text-slate-600"><%= t("pages.versions") %></dt>
          <dd class="text-2xl font-semibold text-slate-900"><%= @versions.size %></dd>
        </div>
        <div class="flex items-center justify-between">
          <dt class="text-slate-600"><%= t("pages.queued") %></dt>
          <dd class="text-2xl font-semibold text-slate-900"><%= @queue_runs_count %></dd>
        </div>
        <div class="flex items-center justify-between">
          <dt class="text-slate-600"><%= t("pages.messages") %></dt>
          <dd class="text-2xl font-semibold text-slate-900"><%= @demo_messages_count %></dd>
        </div>
      </dl>
    </div>

    <div class="rounded-3xl border border-emerald-200 bg-emerald-50 p-6 shadow-sm">
      <p class="text-sm font-semibold text-emerald-700"><%= t("pages.demo_account") %></p>
      <p class="mt-2 text-sm text-emerald-900"><%= User.human_attribute_name(:email_address) %>: <code>demo@example.com</code></p>
      <p class="mt-1 text-sm text-emerald-900"><%= User.human_attribute_name(:password) %>: <code>password123</code></p>
    </div>
  </aside>
</section>

<section class="mt-10 grid gap-6 lg:grid-cols-2">
  <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="mb-4 flex items-center justify-between">
      <div>
        <h2 class="text-xl font-semibold text-slate-900"><%= t("pages.interactive") %></h2>
        <p class="mt-1 text-sm text-slate-600"><%= t("pages.runtime_help", runtime: current_runtime_label) %></p>
      </div>
      <span class="text-sm text-slate-500"><%= t("pages.cards", count: @runtime_features.size) %></span>
    </div>

    <div class="space-y-4">
      <% @runtime_features.each do |feature| %>
        <article class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
          <div class="flex flex-col items-start gap-4 sm:flex-row sm:justify-between">
            <div class="min-w-0">
              <span class="<%= feature_badge_classes(feature) %>"><%= feature.category_label %></span>
              <h3 class="mt-3 text-lg font-semibold text-slate-900"><%= feature.title %></h3>
              <p class="mt-2 text-sm leading-6 text-slate-600"><%= feature.summary %></p>
              <div class="mt-3 flex flex-wrap gap-2">
                <% feature.available_versions.each do |version| %>
                  <span class="<%= version_chip_classes(version, active: version.latest?) %>"><%= version.label %></span>
                <% end %>
              </div>
            </div>
            <%= link_to t("pages.open"), feature_path(feature.slug, compare: compare_query_value(VersionCatalog.default_compare_keys)), class: "rounded-full border border-slate-200 bg-white px-4 py-2 text-sm text-slate-700 hover:bg-slate-100" %>
          </div>
        </article>
      <% end %>
    </div>
  </div>

  <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="mb-4 flex items-center justify-between">
      <div>
        <h2 class="text-xl font-semibold text-slate-900"><%= t("pages.platform") %></h2>
        <p class="mt-1 text-sm text-slate-600"><%= t("pages.platform_help", versions: catalog_version_heading(VersionCatalog.default_compare_keys)) %></p>
      </div>
      <span class="text-sm text-slate-500"><%= t("pages.cards", count: @platform_features.size) %></span>
    </div>

    <div class="space-y-4">
      <% @platform_features.each do |feature| %>
        <article class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
          <span class="<%= feature_badge_classes(feature) %>"><%= feature.category_label %></span>
          <h3 class="mt-3 text-lg font-semibold text-slate-900"><%= feature.title %></h3>
          <p class="mt-2 text-sm leading-6 text-slate-600"><%= feature.summary %></p>
          <div class="mt-3 flex flex-wrap gap-2">
            <% feature.available_versions.each do |version| %>
              <span class="<%= version_chip_classes(version, active: version.latest?) %>"><%= version.label %></span>
            <% end %>
          </div>
          <%= link_to t("pages.compare"), feature_path(feature.slug, compare: compare_query_value(VersionCatalog.default_compare_keys)), class: "mt-4 inline-flex rounded-full border border-slate-200 bg-white px-4 py-2 text-sm text-slate-700 hover:bg-slate-100" %>
        </article>
      <% end %>
    </div>
  </div>
</section>
