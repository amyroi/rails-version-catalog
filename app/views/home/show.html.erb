<% content_for :title, "Rails 8.0 UI Diff Catalog" %>

<section class="grid gap-8 lg:grid-cols-[1.4fr_0.8fr]">
  <div class="rounded-3xl border border-white/10 bg-gradient-to-br from-slate-900 via-slate-900 to-slate-800 p-8">
    <p class="mb-3 text-sm uppercase tracking-[0.2em] text-sky-300">Rails 7.2 → 8.0</p>
    <h1 class="text-4xl font-semibold tracking-tight">UI で確認する Rails 8 の差分カタログ</h1>
    <p class="mt-4 max-w-3xl text-base leading-7 text-slate-300">
      Rails 8 の新しい default story を、認証・Queue・Cable・Cache・Deploy の観点から 1 つのアプリで触れます。
      7.2 との差分を比較表で確認しつつ、主要機能は実際に動かせます。
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <%= link_to "機能一覧を見る", features_path, class: "rounded-full bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-200" %>
      <%= link_to "Authentication demo", feature_path("authentication-generator"), class: "rounded-full border border-white/15 px-5 py-3 text-sm font-semibold hover:bg-white/5" %>
      <%= link_to "Solid Queue demo", feature_path("solid-queue"), class: "rounded-full border border-white/15 px-5 py-3 text-sm font-semibold hover:bg-white/5" %>
    </div>
  </div>

  <aside class="grid gap-4">
    <div class="rounded-3xl border border-white/10 bg-slate-900 p-6">
      <p class="text-sm text-slate-400">Catalog coverage</p>
      <dl class="mt-4 space-y-4">
        <div class="flex items-center justify-between">
          <dt class="text-slate-300">Runtime demos</dt>
          <dd class="text-2xl font-semibold"><%= @runtime_features.size %></dd>
        </div>
        <div class="flex items-center justify-between">
          <dt class="text-slate-300">Comparison cards</dt>
          <dd class="text-2xl font-semibold"><%= @platform_features.size %></dd>
        </div>
        <div class="flex items-center justify-between">
          <dt class="text-slate-300">Queued examples</dt>
          <dd class="text-2xl font-semibold"><%= @queue_runs_count %></dd>
        </div>
        <div class="flex items-center justify-between">
          <dt class="text-slate-300">Live messages</dt>
          <dd class="text-2xl font-semibold"><%= @demo_messages_count %></dd>
        </div>
      </dl>
    </div>

    <div class="rounded-3xl border border-emerald-400/20 bg-emerald-400/10 p-6">
      <p class="text-sm font-semibold text-emerald-200">Demo account</p>
      <p class="mt-2 text-sm text-emerald-50">email: <code>demo@example.com</code></p>
      <p class="mt-1 text-sm text-emerald-50">password: <code>password123</code></p>
    </div>
  </aside>
</section>

<section class="mt-10 grid gap-6 lg:grid-cols-2">
  <div class="rounded-3xl border border-white/10 bg-slate-900 p-6">
    <div class="mb-4 flex items-center justify-between">
      <h2 class="text-xl font-semibold">Runtime demos</h2>
      <span class="text-sm text-slate-400">6 cards</span>
    </div>

    <div class="space-y-4">
      <% @runtime_features.each do |feature| %>
        <article class="rounded-2xl border border-white/10 bg-slate-950/60 p-5">
          <div class="flex items-start justify-between gap-4">
            <div>
              <span class="<%= feature_badge_classes(feature) %>"><%= feature.category_label %></span>
              <h3 class="mt-3 text-lg font-semibold"><%= feature.title %></h3>
              <p class="mt-2 text-sm leading-6 text-slate-400"><%= feature.summary %></p>
            </div>
            <%= link_to "Open", feature_path(feature.slug), class: "rounded-full border border-white/10 px-4 py-2 text-sm hover:bg-white/5" %>
          </div>
        </article>
      <% end %>
    </div>
  </div>

  <div class="rounded-3xl border border-white/10 bg-slate-900 p-6">
    <div class="mb-4 flex items-center justify-between">
      <h2 class="text-xl font-semibold">Platform / defaults</h2>
      <span class="text-sm text-slate-400">3 cards</span>
    </div>

    <div class="space-y-4">
      <% @platform_features.each do |feature| %>
        <article class="rounded-2xl border border-white/10 bg-slate-950/60 p-5">
          <span class="<%= feature_badge_classes(feature) %>"><%= feature.category_label %></span>
          <h3 class="mt-3 text-lg font-semibold"><%= feature.title %></h3>
          <p class="mt-2 text-sm leading-6 text-slate-400"><%= feature.summary %></p>
          <%= link_to "Compare", feature_path(feature.slug), class: "mt-4 inline-flex rounded-full border border-white/10 px-4 py-2 text-sm hover:bg-white/5" %>
        </article>
      <% end %>
    </div>
  </div>
</section>
