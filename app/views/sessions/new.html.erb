<div class="mx-auto max-w-2xl rounded-3xl border border-white/10 bg-slate-900 p-8">
  <h1 class="text-3xl font-semibold tracking-tight">Sign in</h1>
  <p class="mt-3 text-sm leading-6 text-slate-400">Use the generated Rails 8 authentication flow or the seeded demo account.</p>

  <div class="mt-5 rounded-2xl border border-emerald-400/20 bg-emerald-400/10 p-4 text-sm text-emerald-50">
    Demo account: <code>demo@example.com</code> / <code>password123</code>
  </div>

  <%= form_with url: session_url, class: "mt-8 space-y-5" do |form| %>
    <div>
      <%= form.label :email_address, class: "text-sm text-slate-300" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "mt-2 w-full rounded-2xl border border-white/10 bg-slate-950 px-4 py-3 text-sm text-slate-100" %>
    </div>

    <div>
      <%= form.label :password, class: "text-sm text-slate-300" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "mt-2 w-full rounded-2xl border border-white/10 bg-slate-950 px-4 py-3 text-sm text-slate-100" %>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <%= form.submit "Sign in", class: "rounded-full bg-white px-5 py-3 text-sm font-semibold text-slate-950 hover:bg-slate-200" %>
      <%= link_to "Forgot password?", new_password_path, class: "rounded-full border border-white/10 px-5 py-3 text-sm hover:bg-white/5" %>
      <%= link_to "Create account", new_user_path, class: "rounded-full border border-white/10 px-5 py-3 text-sm hover:bg-white/5" %>
    </div>
  <% end %>
</div>
