<div class="mx-auto max-w-2xl rounded-3xl border border-slate-200 bg-white p-8 shadow-sm">
  <h1 class="text-3xl font-semibold tracking-tight text-slate-900">Sign in</h1>
  <p class="mt-3 text-sm leading-6 text-slate-600">Use the generated Rails 8 authentication flow or the seeded demo account.</p>

  <div class="mt-5 rounded-2xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-900">
    Demo account: <code>demo@example.com</code> / <code>password123</code>
  </div>

  <%= form_with url: session_url, class: "mt-8 space-y-5" do |form| %>
    <div>
      <%= form.label :email_address, class: "text-sm text-slate-600" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "mt-2 w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900" %>
    </div>

    <div>
      <%= form.label :password, class: "text-sm text-slate-600" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "mt-2 w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900" %>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <%= form.submit "Sign in", class: "rounded-full bg-slate-900 px-5 py-3 text-sm font-semibold text-white hover:bg-slate-700" %>
      <%= link_to "Forgot password?", new_password_path, class: "rounded-full border border-slate-200 bg-white px-5 py-3 text-sm text-slate-700 hover:bg-slate-100" %>
      <%= link_to "Create account", new_user_path, class: "rounded-full border border-slate-200 bg-white px-5 py-3 text-sm text-slate-700 hover:bg-slate-100" %>
    </div>
  <% end %>
</div>
