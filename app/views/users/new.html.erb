<% content_for :title, "Create demo account" %>

<div class="mx-auto max-w-2xl rounded-3xl border border-slate-200 bg-white p-8 shadow-sm">
  <h1 class="text-3xl font-semibold tracking-tight text-slate-900">Create a demo account</h1>
  <p class="mt-3 text-sm leading-6 text-slate-600">Rails 8 authentication generator includes login and password reset. This page adds a lightweight sign-up step so you can try the flow end to end.</p>

  <%= form_with model: @user, class: "mt-8 space-y-5" do |form| %>
    <% if @user.errors.any? %>
      <div class="rounded-2xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-800">
        <%= @user.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div>
      <%= form.label :email_address, class: "text-sm text-slate-600" %>
      <%= form.email_field :email_address, required: true, class: "mt-2 w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900" %>
    </div>

    <div>
      <%= form.label :password, class: "text-sm text-slate-600" %>
      <%= form.password_field :password, required: true, class: "mt-2 w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900" %>
    </div>

    <div>
      <%= form.label :password_confirmation, class: "text-sm text-slate-600" %>
      <%= form.password_field :password_confirmation, required: true, class: "mt-2 w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900" %>
    </div>

    <%= form.submit "Create account", class: "rounded-full bg-slate-900 px-5 py-3 text-sm font-semibold text-white hover:bg-slate-700" %>
  <% end %>
</div>
