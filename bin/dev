#!/usr/bin/env sh

if [ -f .env ]; then
  set -a
  . ./.env
  set +a
fi

if ! gem list foreman -i --silent; then
  echo "Installing foreman..."
  gem install foreman
fi

# Default Rails web port to APP_PORT / PORT / 3000.
# Foreman increments PORT per process, so keep the Rails port separately
# for other processes such as the Next.js frontend.
export RAILS_PORT="${APP_PORT:-${PORT:-3000}}"
export PORT="${RAILS_PORT}"

# Let the debug gem allow remote connections,
# but avoid loading until `debugger` is called
export RUBY_DEBUG_OPEN="true"
export RUBY_DEBUG_LAZY="true"

exec foreman start -f Procfile.dev "$@"
